flowchart TB
    %% ---------------------------------------------------------
    %% Nodes (Inputs)
    %% ---------------------------------------------------------
    RawData[("📄 Raw Data<br/>(winequality.csv)")]
    InferenceData[("📄 Inference Data<br/>(batch.csv)")]

    %% ---------------------------------------------------------
    %% Run 1: Prepare Data
    %% ---------------------------------------------------------
    subgraph Run_Prepare [ ]
        direction TB
        Title_Prepare["MLflow Run: prepare-data"]
        PrepareStep["1. Command:<br/>prepare-data"]
        ArtRaw[("📦 Artifact:<br/>raw_data.parquet")]
        
        Title_Prepare ~~~ PrepareStep
        PrepareStep -->|"Log"| ArtRaw
    end

    %% ---------------------------------------------------------
    %% Run 2: Training
    %% ---------------------------------------------------------
    subgraph Run_Training [ ]
        direction TB
        Title_Training["MLflow Run: training"]
        TrainStep["2. Command:<br/>training"]
        ArtModel[("📦 Artifact:<br/>Model (sklearn)")]
        
        Title_Training ~~~ TrainStep
        TrainStep -->|"Log"| ArtModel
    end

    %% ---------------------------------------------------------
    %% Run 3: Inference DQ
    %% ---------------------------------------------------------
    subgraph Run_DQ [ ]
        direction TB
        Title_DQ["MLflow Run: inference-dq"]
        DQStep["3. Command:<br/>inference-dq"]
        ArtInfFeat[("📦 Artifact:<br/>inference_features.parquet")]
        
        Title_DQ ~~~ DQStep
        DQStep -->|"Log (if pass)"| ArtInfFeat
    end

    %% Force Training and DQ to be side-by-side
    TrainStep ~~~ DQStep

    %% ---------------------------------------------------------
    %% Run 4: Inference
    %% ---------------------------------------------------------
    subgraph Run_Inference [ ]
        direction TB
        Title_Inference["MLflow Run: inference"]
        InferStep["4. Command:<br/>inference"]
        ArtPred[("📦 Artifact:<br/>predictions.parquet")]
        
        Title_Inference ~~~ InferStep
        InferStep -->|"Log"| ArtPred
    end

    %% ---------------------------------------------------------
    %% Registry (External Service)
    %% ---------------------------------------------------------
    Registry[("🏛️ Model Registry<br/>(champion/staging)")]

    %% ---------------------------------------------------------
    %% Cross-Run Flows (Lineage)
    %% ---------------------------------------------------------

    %% Prepare Inputs
    RawData -->|"Load"| PrepareStep

    %% Training Inputs
    ArtRaw -->|"Load"| TrainStep
    TrainStep -->|"Register"| Registry
    Registry -.->|"References"| ArtModel

    %% DQ Inputs
    InferenceData -->|"Load (Target)"| DQStep
    ArtRaw -->|"Load (Baseline)"| DQStep

    %% Inference Inputs
    Registry -.->|"Resolve Alias"| InferStep
    ArtModel -->|"Load Model"| InferStep
    ArtInfFeat -->|"Load Features"| InferStep

    %% ---------------------------------------------------------
    %% Styling
    %% ---------------------------------------------------------
    classDef step fill:#E0E7FF,stroke:#4338CA,stroke-width:2px,color:#000
    classDef data fill:#F3F4F6,stroke:#374151,stroke-width:2px,color:#000
    classDef artifact fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#000
    classDef registry fill:#FEE2E2,stroke:#DC2626,stroke-width:2px,color:#000
    
    %% Title Styling - invisible background, bold text
    classDef runTitle fill:none,stroke:none,font-weight:bold,font-size:16px,color:#475569
    
    %% Subgraph Styling
    classDef runGroup fill:#FFFFFF,stroke:#94A3B8,stroke-width:2px,stroke-dasharray: 5 5,color:#475569

    class PrepareStep,TrainStep,DQStep,InferStep step
    class RawData,InferenceData data
    class ArtRaw,ArtModel,ArtInfFeat,ArtPred artifact
    class Registry registry
    class Run_Prepare,Run_Training,Run_DQ,Run_Inference runGroup
    class Title_Prepare,Title_Training,Title_DQ,Title_Inference runTitle
