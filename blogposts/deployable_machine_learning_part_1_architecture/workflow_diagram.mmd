flowchart TB
    %% ---------------------------------------------------------
    %% External Inputs
    %% ---------------------------------------------------------
    RawData[("Raw Data<br/>(winequality.csv)")]
    InferenceFile[("Inference Data<br/>(batch.csv)")]

    %% ---------------------------------------------------------
    %% LEFT COLUMN: Data Preparation Path
    %% ---------------------------------------------------------
    subgraph PrepPath[" "]
        direction TB

        subgraph Run_Prepare[MLflow Run: prepare-data]
            direction TB
            PrepareStep["1. prepare-data"]
            ArtRaw[("raw_data.parquet<br/>(validated dataset)")]
            PrepareStep -->|"Log artifact"| ArtRaw
        end

        subgraph Run_Training[MLflow Run: training]
            direction TB
            TrainStep["2. training"]
            ArtModel[("Model<br/>(sklearn pipeline)")]
            TrainStep -->|"Log model"| ArtModel
        end
    end

    %% ---------------------------------------------------------
    %% RIGHT COLUMN: Inference Path
    %% ---------------------------------------------------------
    subgraph InfPath[" "]
        direction TB

        subgraph Run_DQ[MLflow Run: inference-dq]
            direction TB
            DQStep["3. inference-dq"]
            ArtInfFeat[("inference_features.parquet<br/>(drift-checked)")]
            DQStep -->|"Log if pass"| ArtInfFeat
        end

        subgraph Run_Inference[MLflow Run: inference]
            direction TB
            InferStep["4. inference"]
            ArtPred[("predictions.parquet")]
            InferStep -->|"Log"| ArtPred
        end
    end

    %% ---------------------------------------------------------
    %% Model Registry (Central Component)
    %% ---------------------------------------------------------
    Registry[("Model Registry<br/>(staging/champion)")]

    %% ---------------------------------------------------------
    %% DATA FLOWS (Solid Arrows)
    %% ---------------------------------------------------------

    %% Step 1: prepare-data inputs
    RawData -->|"Load"| PrepareStep

    %% Step 2: training inputs
    ArtRaw -->|"Load dataset"| TrainStep
    TrainStep -->|"Register"| Registry

    %% Step 3: inference-dq inputs
    ArtRaw -->|"Load reference"| DQStep
    InferenceFile -->|"Load target"| DQStep

    %% Step 4: inference inputs
    Registry -->|"Load by alias"| InferStep
    ArtInfFeat -->|"Load validated features"| InferStep

    %% ---------------------------------------------------------
    %% LINEAGE REFERENCES (Dotted Arrows - Run ID Parameters)
    %% ---------------------------------------------------------
    TrainStep -.->|"logs prepare_run_id"| Run_Prepare
    DQStep -.->|"logs model_run_id"| Run_Training
    InferStep -.->|"logs inference_dq_run_id"| Run_DQ

    %% ---------------------------------------------------------
    %% Styling
    %% ---------------------------------------------------------
    classDef step fill:#E0E7FF,stroke:#4338CA,stroke-width:2px,color:#000
    classDef data fill:#F3F4F6,stroke:#374151,stroke-width:2px,color:#000
    classDef artifact fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#000
    classDef registry fill:#FEE2E2,stroke:#DC2626,stroke-width:2px,color:#000
    classDef pathGroup fill:#FFFFFF,stroke:none
    classDef runGroup fill:#FFFFFF,stroke:#94A3B8,stroke-width:2px,stroke-dasharray: 5 5,color:#475569

    class PrepareStep,TrainStep,DQStep,InferStep step
    class RawData,InferenceFile data
    class ArtRaw,ArtModel,ArtInfFeat,ArtPred artifact
    class Registry registry
    class PrepPath,InfPath pathGroup
    class Run_Prepare,Run_Training,Run_DQ,Run_Inference runGroup
